# Smoke test credentials — copy this file to .env.smoke, fill in values, then:
#   source .env.smoke && pytest tests/smoke/ --no-cov -v
#
# Optionally override the target Confluence space (defaults to CCFMDEV):
#   export CCFM_SMOKE_SPACE=MYSPACE

export CONFLUENCE_DOMAIN=your-domain.atlassian.net
export CONFLUENCE_EMAIL=your@email.com
export CONFLUENCE_TOKEN=your-api-token
